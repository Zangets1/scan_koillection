# ══════════════════════════════════════════════════════════════════════
#  Scan Koillection — copiez ce fichier en « .env » et adaptez-le.
# ══════════════════════════════════════════════════════════════════════

# ── Koillection (obligatoire) ─────────────────────────────────────────
# URL vue depuis le conteneur. Si Koillection tourne sur le même NAS dans
# un autre conteneur, utilisez son nom de service ou l'IP du NAS.
# Attention : c'est bien le port de Koillection, pas celui de cet outil (8080).
KOILLECTION_URL=http://192.168.1.10:81
KOILLECTION_USERNAME=mon_utilisateur
KOILLECTION_PASSWORD=mon_mot_de_passe
# Mettre à 0 uniquement si Koillection est en HTTPS avec un certificat auto-signé.
KOILLECTION_VERIFY_SSL=1

# Collection par défaut : titre exact, chemin (« Livres / Mangas ») ou UUID.
KOILLECTION_DEFAULT_COLLECTION=Livres

# ── Comportement ──────────────────────────────────────────────────────
# Range chaque tome d'une série dans une sous-collection à son nom.
SERIES_SUBCOLLECTIONS=1
# Crée aussi les genres comme tags Koillection.
GENRES_AS_TAGS=1
# Téléverse la couverture trouvée comme image de l'item.
UPLOAD_COVER=1
# Gabarit du nom de l'item pour les livres en série.
SERIES_ITEM_NAME={series} - T{volume:02d} - {title}

# ── Catalogues interrogés (dans l'ordre : le premier gagne) ───────────
# Valeurs possibles : bnf, sudoc, openlibrary, k10plus, openbd, googlebooks, isbndb
# Chaque catalogue n'est sollicité que sur les ISBN qu'il peut connaître : la
# BnF sur les 978-2, k10plus sur les 978-0/978-1, openBD sur les 978-4. Les
# inscrire tous ne coûte donc rien sur les livres qui ne les concernent pas.
PROVIDERS=bnf,sudoc,openlibrary,k10plus,openbd,googlebooks
# Délai maximal accordé à un catalogue pour une requête.
PROVIDER_TIMEOUT=8
# Plafond global d'une recherche : passé ce délai, la fiche s'affiche avec ce
# qui est arrivé, les catalogues en retard étant signalés « trop lent ».
LOOKUP_DEADLINE=4
# Durée du cache mémoire des recherches, en secondes.
CACHE_TTL=86400

# Clés facultatives (aucune n'est nécessaire au fonctionnement).
GOOGLE_BOOKS_API_KEY=
ISBNDB_API_KEY=

# ── Nommage des champs créés dans Koillection ─────────────────────────
# JSON de correspondance. Laissez une valeur vide pour ne pas créer le champ.
# Champs disponibles : isbn, authors, publisher, published, pages, genres,
# synopsis, read, series, volume, language, source
# FIELD_LABELS={"authors":"Auteur","read":"Lu","pages":"Pages"}

# ── Sécurité ──────────────────────────────────────────────────────────
# Mot de passe d'accès à l'interface (laisser vide = aucune authentification).
APP_PASSWORD=
# Clé de signature des sessions : indispensable si APP_PASSWORD est défini,
# sinon chaque redémarrage déconnecte tout le monde.
# Générez-la avec : openssl rand -base64 32
SESSION_SECRET=
SESSION_DAYS=30

# ── Divers ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=/data

# Propriétaire du dossier ./data monté depuis le NAS. Adaptez-les si le
# conteneur ne parvient pas à écrire son historique (1000:1000 sur la plupart
# des NAS, 1026:100 chez Synology).
PUID=10001
PGID=10001
